{
  "name": "portfolio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "dev": "vite",
    "dev:backend": "php artisan serve --host=127.0.0.1 --port=8000",
    "build": "tsc -b && vite build",
    "lint": "oxlint resources/js vite.config.ts",
    "typecheck": "tsc -b",
    "test:backend": "php artisan test --compact",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down"
  },
  "dependencies": {
    "@inertiajs/react": "^3.7.1",
    "@tailwindcss/vite": "^4.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "laravel-vite-plugin": "^3.2.0",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
